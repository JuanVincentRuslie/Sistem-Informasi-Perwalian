{
  "name": "si-perwalian-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Sistem Informasi Perwalian",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "seed:kaprodi": "node src/seeds/seed-kaprodi.js",
    "seed:dosen-wali": "node src/seeds/seed-dosen-wali.js",
    "seed:mahasiswa": "node src/seeds/seed-mahasiswa.js",
    "seed:master-matkul": "node src/seeds/seed-master-matkul.js",
    "seed:periode-dummy": "node src/seeds/seed-periode-dummy.js",
    "seed:all": "npm run seed:kaprodi && npm run seed:dosen-wali && npm run seed:mahasiswa && npm run seed:master-matkul && npm run seed:periode-dummy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-pg-migrate": "^8.0.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
